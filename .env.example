# Recommended for Vercel & production: Brevo Transactional Email API (free 300 emails/day, avoids Gmail locks)
# Get your API key from Brevo -> Settings -> SMTP & API -> API Keys (starts with xkeysib-...)
BREVO_API_KEY=

# Verified sender email in Brevo -> Senders, Domains & Dedicated IPs (defaults to GMAIL_USER if omitted)
BREVO_SENDER_EMAIL=pressonfitnessgym@gmail.com

# Inbox that receives form submissions (switch to carlvine0926@gmail.com when live for the client)
NEXT_PUBLIC_FORM_RECIPIENT_EMAIL=jerwinmasagca@gmail.com

# Optional fallback: Gmail SMTP (may trigger Google WebLoginRequired locks on cloud hosts like Vercel)
GMAIL_USER=pressonfitnessgym@gmail.com
GMAIL_APP_PASSWORD=


